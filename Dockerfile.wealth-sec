# Zeabur entry for service "wealth-sec" — mirrors apps/services/sec/Dockerfile
# (verified locally as image wealth-sec:verify). Keep the two in sync.
FROM python:3.12-slim
LABEL "language"="python"

WORKDIR /src
COPY . .

RUN pip install --no-cache-dir -e ".[sec]" -r apps/services/sec/requirements.txt

EXPOSE 8080
CMD ["sh", "-c", "uvicorn apps.services.sec.main:app --host 0.0.0.0 --port ${PORT:-8080}"]
