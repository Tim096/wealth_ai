# Zeabur entry for service "wealth-agent" — mirrors apps/services/agent/Dockerfile
# (verified locally as image wealth-agent:latest). Keep the two in sync.
FROM python:3.12-slim
LABEL "language"="python"

ENV PYTHONUNBUFFERED=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

WORKDIR /src
COPY . .

RUN pip install --no-cache-dir -e ".[browser]" -r apps/services/agent/requirements.txt \
 && playwright install --with-deps chromium \
 && rm -rf /var/lib/apt/lists/*

EXPOSE 8080
CMD ["sh", "-c", "uvicorn main:app --app-dir apps/services/agent --host 0.0.0.0 --port ${PORT:-8080}"]
